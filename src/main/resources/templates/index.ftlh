<#import "layout.ftlh" as layout>
<@layout.page title="Sanrio Characters">

<section class="page-header">
  <h2>Discover the Wonderful World of Sanrio Characters!</h2>
</section>

<div class="row row-cols-1 row-cols-md-3 g-4">
  <div class="col">
    <div class="card text-center mb-3" style="width: 22rem;">
      <img src="https://pngimg.com/uploads/hello_kitty/hello_kitty_PNG42.png" class="card-img-top" alt="...">
      <div class="card-body">
        <h5 class="card-title">Hello Kitty</h5>
        <h6 class="card-subtitle mb-2 text-body-secondary">Universe: Sanrio</h6>
        <span class="badge rounded-pill text-bg-primary">Cat</span>
        <p class="card-text">A bright cheerful cat known for her signature bow and friendly nature. She stands 5 apples tall, only weighing 3.</p>
         <a href="details.html" class="btn btn-primary">Get to know me!</a>
      </div>
    </div>
  </div>

  <div class="col">
    <div class= "card text-center mb-3" style="width: 22rem;">
      <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcS_dooY7JLryEq7Z9EWvdSiW05WerAEIHqB22YtxhgK0Q&s=10" class="card-img-top" alt="...">
      <div class="card-body">
        <h5 class="card-title">My Melody</h5>
        <h6 class="card-subtitle mb-2 text-body-secondary">Universe: Sanrio</h6>
        <span class="badge rounded-pill text-bg-primary">Bunny</span>
        <p class="card-text">A sweet and kind-hearted rabbit always sporting a flower on her hood. She loves baking, crafting, and taking naps.</p>
        <a href="details.html" class="btn btn-primary">Get to know me!</a>
      </div>
    </div>
  </div>

  <div class="col">
    <div class= "card text-center mb-3" style="width: 22rem;">
      <img src="https://i.pinimg.com/564x/4a/88/ae/4a88ae53ff374843c22a1d51714fb7a3.jpg" class="card-img-top" alt="...">
      <div class="card-body">
        <h5 class="card-title">Kuromi</h5>
        <h6 class="card-subtitle mb-2 text-body-secondary">Universe: Sanrio</h6>
        <span class="badge rounded-pill text-bg-primary">Bunny</span>
        <p class="card-text">A mischievous rabbit known for her love of pranks and jester hat. She's best friend and friendly rival to My Melody.</p>
        <a href="details.html" class="btn btn-primary">Get to know me!</a>
      </div>
    </div>
  </div>

     <div class="col">
    <div class= "card text-center mb-3" style="width: 22rem;">
      <img src= "https://www.sdpnoticias.com/resizer/v2/LWITP4DDMVDADCFFRAZIAXNIWA.jpg?smart=true&auth=075aad3615a228923e9eb93fbcc920ce761e6cc7f22190d8c3bd1fe76c3d499c&width=1200&height=675" class="card-img-top" alt="...">
      <div class="card-body">
        <h5 class="card-title">Cinnamaroll</h5>
        <h6 class="card-subtitle mb-2 text-body-secondary">Universe: Sanrio</h6>
        <span class="badge rounded-pill text-bg-primary">Puppy</span>
        <p class="card-text">Born above the clouds with a tail resembling a cinnamon roll and the ability to fly with the help of his floppy ears.</p>
        <a href="details.html" class="btn btn-primary">Get to know me!</a>
      </div>
    </div>
  </div>

 <div class="col">
    <div class= "card text-center mb-3" style="width: 22rem;">
      <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTX9VJX3TONS1L021AQGJ2x-4jVvQ_yp8398s4G3xvlmQ&s=10" class="card-img-top" alt="...">
      <div class="card-body">
        <h5 class="card-title">Little Twin Stars</h5>
        <h6 class="card-subtitle mb-2 text-body-secondary">Universe: Sanrio</h6>
        <span class="badge rounded-pill text-bg-primary">Angels</span>
        <p class="card-text">Twin angel siblings named Kiki and Lala born on O-Star Cloud. This duo is known for their playful nature and magical abilities.</p>
        <a href="details.html" class="btn btn-primary">Get to know me!</a>
      </div>
    </div>
  </div>

  <div class="col">
    <div class= "card text-center mb-3" style="width: 22rem;">
      <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT9u1jgvC9HHOFKh44ymiqcfrE8iE836x3a7pe_LmOQiw&s=10" class="card-img-top" alt="...">
      <div class="card-body">
        <h5 class="card-title">Chococat</h5>
        <h6 class="card-subtitle mb-2 text-body-secondary">Universe: Sanrio</h6>
        <span class="badge rounded-pill text-bg-primary">Cat</span>
        <p class="card-text">A curious, clumsy cat with whiskers like antennas that he uses to catch information. He loves stargazing, reading, and science.</p>
        <a href="details.html" class="btn btn-primary">Get to know me!</a>
      </div>
    </div>
  </div>

  <div class="col">
    <div class= "card text-center mb-3" style="width: 22rem;">
      <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR8m1zi52sslEfXn8f65xgcgdP7GF6eCtbtMsZa78A40g&s=10" class="card-img-top" alt="...">
      <div class="card-body">
        <h5 class="card-title">Keroppi</h5>
        <h6 class="card-subtitle mb-2 text-body-secondary">Universe: Sanrio</h6>
        <span class="badge rounded-pill text-bg-primary">Frog</span>
        <p class="card-text">A curious little frog who loves singing and rainy days. He is full of energy and always ready for new adventures.</p>
        <a href="details.html" class="btn btn-primary">Get to know me!</a>
      </div>
    </div>
  </div>

</div>
</@layout.page>